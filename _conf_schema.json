{
  "sync_menu": {
    "description": "启动时同步自定义菜单",
    "type": "bool",
    "default": true,
    "hint": "关闭后仅读取 QQ 当前菜单，不会覆盖 QQ 机器人菜单。"
  },
  "qq_platforms": {
    "description": "QQ 官方机器人平台凭证",
    "type": "template_list",
    "default": [],
    "obvious_hint": true,
    "hint": "填写 AppID 和 ClientSecret；留空时尝试从 AstrBot 平台配置读取。",
    "templates": {
      "qq_platform": {
        "name": "QQ 机器人",
        "display_item": "appid",
        "items": {
          "appid": {
            "description": "AppID",
            "type": "string"
          },
          "secret": {
            "description": "ClientSecret",
            "type": "string"
          },
          "platform": {
            "description": "平台类型",
            "type": "string",
            "options": ["qq_official", "qq_official_webhook"],
            "default": "qq_official"
          }
        }
      }
    }
  },
  "menu": {
    "description": "QQ 私聊自定义菜单",
    "type": "template_list",
    "default": [],
    "obvious_hint": true,
    "hint": "点击「添加条目」选择菜单类型并填写内容。一级菜单最多 3 个；需要子菜单时先添加一条「子菜单」，再添加「发送消息」或「跳转链接」条目，并把「父菜单名称」填写为该子菜单的名称。",
    "templates": {
      "send_message": {
        "name": "发送消息",
        "display_item": "name",
        "items": {
          "name": {
            "description": "菜单名称",
            "type": "string",
            "default": ""
          },
          "message": {
            "description": "点击后发送的消息",
            "type": "string",
            "default": ""
          },
          "parent": {
            "description": "父菜单名称",
            "type": "string",
            "default": "",
            "hint": "留空为一级菜单；填写某个「子菜单」条目的名称时，作为它的子项。"
          }
        }
      },
      "link": {
        "name": "跳转链接",
        "display_item": "name",
        "items": {
          "name": {
            "description": "菜单名称",
            "type": "string",
            "default": ""
          },
          "link": {
            "description": "点击后打开的链接",
            "type": "string",
            "default": ""
          },
          "parent": {
            "description": "父菜单名称",
            "type": "string",
            "default": "",
            "hint": "留空为一级菜单；填写某个「子菜单」条目的名称时，作为它的子项。"
          }
        }
      },
      "menu": {
        "name": "子菜单",
        "display_item": "name",
        "items": {
          "name": {
            "description": "子菜单名称",
            "type": "string",
            "default": ""
          }
        }
      }
    }
  }
}
