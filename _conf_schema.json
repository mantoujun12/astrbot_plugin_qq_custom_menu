{
  "language": {
    "description": "插件日志语言",
    "type": "string",
    "options": [
      "zh-CN",
      "en-US"
    ],
    "default": "zh-CN",
    "hint": "仅影响插件日志，不影响用户自定义的菜单内容。"
  },
  "sync_menu": {
    "description": "启动时同步私聊菜单",
    "type": "bool",
    "default": true,
    "hint": "关闭后仅读取 QQ 当前私聊菜单，不会覆盖线上内容。"
  },
  "qq_platforms": {
    "description": "兼容性平台凭证",
    "type": "template_list",
    "default": [],
    "obvious_hint": true,
    "hint": "本页保留旧版全局配置；新版请到插件视图的「机器人」逐台配置。未被新版按 AppID 接管的平台仍可使用这里的凭证。",
    "templates": {
      "qq_platform": {
        "name": "QQ 机器人",
        "display_item": "appid",
        "items": {
          "appid": {
            "description": "AppID",
            "type": "string"
          },
          "secret": {
            "description": "ClientSecret",
            "type": "string"
          },
          "platform": {
            "description": "平台类型",
            "type": "string",
            "options": [
              "qq_official",
              "qq_official_webhook"
            ],
            "default": "qq_official"
          }
        }
      }
    }
  },
  "menu": {
    "description": "兼容性私聊自定义菜单",
    "type": "template_list",
    "default": [],
    "obvious_hint": true,
    "hint": "旧版全局私聊菜单仍可在这里维护；已被「机器人」接管的 AppID 不再使用本菜单。一级菜单最多 10 个，每个子菜单最多 5 项。",
    "templates": {
      "send_message": {
        "name": "发送消息",
        "display_item": "name",
        "items": {
          "name": {
            "description": "菜单名称",
            "type": "string",
            "default": ""
          },
          "message": {
            "description": "点击后发送的消息",
            "type": "string",
            "default": ""
          },
          "parent": {
            "description": "父菜单名称",
            "type": "string",
            "default": "",
            "hint": "留空为一级菜单；填写某个「子菜单」条目的名称时，作为它的子项。"
          }
        }
      },
      "link": {
        "name": "跳转链接",
        "display_item": "name",
        "items": {
          "name": {
            "description": "菜单名称",
            "type": "string",
            "default": ""
          },
          "link": {
            "description": "点击后打开的链接",
            "type": "string",
            "default": "",
            "hint": "QQ 要求以 https:// 开头；未填写协议时会自动补全为 https://。"
          },
          "parent": {
            "description": "父菜单名称",
            "type": "string",
            "default": "",
            "hint": "留空为一级菜单；填写某个「子菜单」条目的名称时，作为它的子项。"
          }
        }
      },
      "switch": {
        "name": "开关",
        "display_item": "name",
        "items": {
          "name": {
            "description": "开关名称",
            "type": "string",
            "default": ""
          },
          "switch_id": {
            "description": "开关 ID",
            "type": "string",
            "default": "",
            "hint": "用户切换后，消息 ext 中会携带这个标识。"
          },
          "default": {
            "description": "默认开启",
            "type": "bool",
            "default": false
          }
        }
      },
      "menu": {
        "name": "子菜单",
        "display_item": "name",
        "items": {
          "name": {
            "description": "子菜单名称",
            "type": "string",
            "default": ""
          }
        }
      }
    }
  }
}
